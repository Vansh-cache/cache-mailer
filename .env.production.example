# Production / security-testing settings for docker-compose.prod.yml.
# Generate a filled-in copy with random secrets instead of editing by hand:
#   node scripts/init-production-env.mjs mailer.example.com ops@example.com
# The result (.env.production) is gitignored. Never commit it.

# Public hostname (DNS A/AAAA record must point at this server for HTTPS).
APP_DOMAIN=mailer.example.com
# Caddy global options: "email <address>" for Let's Encrypt, or "local_certs"
# for an internal CA when testing without a public DNS name.
CADDY_GLOBAL_OPTIONS=email ops@example.com
HTTP_PORT=80
HTTPS_PORT=443

# Must be https and publicly reachable; the server refuses to start otherwise.
APP_URL=https://mailer.example.com
TRACKING_URL=https://mailer.example.com
MEDIA_URL=https://mailer.example.com/media

# Secrets (generated by the init script).
MYSQL_ROOT_PASSWORD=<generated>
MYSQL_PASSWORD=<generated>
JWT_SECRET=<generated>
ENCRYPTION_KEY=<generated>

# Optional integrations.
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
ZOHO_ACCOUNTS_URL=https://accounts.zoho.in
ZOHO_API_URL=https://www.zohoapis.in
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REDIRECT_URI=https://mailer.example.com/api/zoho/callback

SEND_DELAY_MIN_MS=2000
SEND_DELAY_MAX_MS=8000
COMPANY_WEBSITE=https://cachedigitech.com
LOG_LEVEL=info
