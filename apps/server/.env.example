# Copy to apps/server/.env and fill in every <...> value. Never commit .env.
# In production (NODE_ENV=production) the server refuses to start with
# placeholder/weak secrets, non-https public URLs, or a localhost MEDIA_URL.
NODE_ENV=development
API_PORT=4000
TRACKING_PORT=4100
# Public URLs. MEDIA_URL must be reachable from the internet in production.
APP_URL=http://localhost:5173
TRACKING_URL=http://127.0.0.1:4100
MEDIA_URL=http://127.0.0.1:4000/media
# mysql://<user>:<password>@<host>:<port>/<database> (URL-encode special characters)
DATABASE_URL=mysql://<db_user>:<db_password>@127.0.0.1:3307/bulk_mailer
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=<generate-a-random-48-byte-secret>
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=<generate-64-hex-characters>
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
ZOHO_ACCOUNTS_URL=https://accounts.zoho.in
ZOHO_API_URL=https://www.zohoapis.in
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REDIRECT_URI=http://localhost:4000/api/zoho/callback
UPLOAD_DIR=data/uploads
BACKUP_DIR=
# One-time bootstrap admin for `prisma db seed` (no default exists). Use a
# strong password (14+ chars), then delete it from .env after first sign-in.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEND_DELAY_MIN_MS=2000
SEND_DELAY_MAX_MS=8000
COMPANY_WEBSITE=https://cachedigitech.com
LOG_LEVEL=info
