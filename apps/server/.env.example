# On the production VM set NODE_ENV=production, use the public https URLs,
# and replace JWT_SECRET + ENCRYPTION_KEY with fresh random values.
NODE_ENV=development
API_PORT=4000
TRACKING_PORT=4100
APP_URL=http://localhost:5173
TRACKING_URL=http://127.0.0.1:4100
MEDIA_URL=http://127.0.0.1:4000/media
DATABASE_URL=mysql://mailer:mailer@127.0.0.1:3307/bulk_mailer
JWT_SECRET=dev-only-change-this-jwt-secret-32b
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
ZOHO_ACCOUNTS_URL=https://accounts.zoho.in
ZOHO_API_URL=https://www.zohoapis.in
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REDIRECT_URI=http://localhost:4000/api/zoho/callback
UPLOAD_DIR=data/uploads
BACKUP_DIR=
# Bootstrap admin for the one-time seed. Change this password after first sign-in.
SEED_ADMIN_EMAIL=admin@mailer.com
SEED_ADMIN_PASSWORD=Qwe@123
SEND_DELAY_MIN_MS=2000
SEND_DELAY_MAX_MS=8000
COMPANY_WEBSITE=https://cachedigitech.com
