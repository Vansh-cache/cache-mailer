    "dotenv": "^16.5.0",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "html-to-text": "^9.0.5",
    "jsonwebtoken": "^9.0.2",
    "mjml": "^4.15.3",
    "multer": "^1.4.5-lts.2",
    "node-cron": "^3.0.3",
