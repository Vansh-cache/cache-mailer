{
  "name": "@cdt/server",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "dev:tracking": "tsx watch src/tracking.ts",
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.seed.json",
    "test": "tsx --test test/**/*.test.ts",
    "start": "node dist/index.js",
    "start:worker": "node dist/worker.js",
    "start:tracking": "node dist/tracking.js",
    "migrate:deploy": "prisma migrate deploy",
    "seed:prod": "node dist-seed/prisma/seed.js"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "csv-parse": "^7.0.3",
    "csv-stringify": "^6.5.2",
    "dotenv": "^16.5.0",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "html-to-text": "^10.0.1",
    "jsonwebtoken": "^9.0.2",
    "mjml": "^5.4.1",
    "multer": "^1.4.5-lts.2",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.1.7",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "prisma": "^6.19.3",
    "sanitize-html": "^2.15.0",
    "sharp": "^0.35.5",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/mjml": "^5.4.2",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.13.14",
    "@types/nodemailer": "^8.0.2",
    "@types/sanitize-html": "^2.13.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
